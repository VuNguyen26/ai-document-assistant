NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_document_assistant?schema=public"

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=uploads

# Cloudflare R2
# Required only when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
